# Pilihan provider: grizzlysms, fivesim, smsman
PROVIDER=smsman

# SMS-Man (API v2.0)
SMSMAN_API_KEY=your_smsman_token_here
SMSMAN_COUNTRY_ID=22
SMSMAN_APPLICATION_ID=jio

# GrizzlySMS
# GRIZZLY_API_KEY=your_grizzly_api_key_here

# 5SIM
# FIVESIM_API_KEY=your_5sim_token_here

# Rotating Proxy (Opsional, format: http://user:pass@host:port atau comma-separated list)
# PROXY_URL=http://user:pass@india-residential-proxy.net:8080

MAX_PRICE=0.5
CANCEL_DELAY_SECONDS=150
OTP_FAIL_DELAY_SECONDS=420
CONCURRENCY=2
DB_PATH=results.db
# TG_BOT_TOKEN=123:abc
# TG_CHAT_ID=-456